# =============================================================================
# Template for terraform/secrets.auto.tfvars — copy this file:
#
#     cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# then fill in the real values. The copy is gitignored (terraform/.gitignore
# ignores *.tfvars); only this .example template is committed. Never put real
# secrets in this file.
#
# If you prefer, you can skip the AWS keys and use a named profile in
# ~/.aws/credentials instead (see README) — the secrets file simply takes
# precedence when present. db_password is always required, though: it has no
# default anywhere, on purpose.
# =============================================================================

aws_access_key = "AKIA..."
aws_secret_key = "..."

# Master password for the RDS database (min 12 chars; avoid / @ " and spaces,
# which RDS rejects). Generate one, e.g.:  openssl rand -base64 18
db_password = "..."
